<?xml version="1.0" encoding="utf-8"?>
<!-- Activity data stays on the device or in the user's StrideMate account; no OS cloud backup. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" path="." /><exclude domain="database" path="." /><exclude domain="sharedpref" path="." /><exclude domain="file" path="." /></cloud-backup>
    <device-transfer><exclude domain="root" path="." /></device-transfer>
</data-extraction-rules>
